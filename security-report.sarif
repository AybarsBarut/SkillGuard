{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SkillGuard",
          "version": "1.0.0",
          "informationUri": "https://github.com/skillguard/skillguard",
          "rules": [
            {
              "id": "SEC-SENSITIVE-COMMENT",
              "name": "Security-Sensitive Code Comment",
              "shortDescription": {
                "text": "Security-Sensitive Code Comment"
              },
              "fullDescription": {
                "text": "Exposes security bypass or hardcoded credentials"
              },
              "help": {
                "text": "Generalize comments; do not expose internal bypasses or vulnerability details."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "PRV-AI-COAUTHOR",
              "name": "AI Co-Author / Contributor Tag",
              "shortDescription": {
                "text": "AI Co-Author / Contributor Tag"
              },
              "fullDescription": {
                "text": "Exposes live AI Co-Author / Contributor Tag in plain text."
              },
              "help": {
                "text": "Replace with environment variable and register in .env"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "PRV-AI-PROVENANCE",
              "name": "AI Agent Fingerprint / Attribution Leak",
              "shortDescription": {
                "text": "AI Agent Fingerprint / Attribution Leak"
              },
              "fullDescription": {
                "text": "Exposes live AI Agent Fingerprint / Attribution Leak in plain text."
              },
              "help": {
                "text": "Replace with environment variable and register in .env"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SEC-INTERNAL-IP",
              "name": "Private/Internal IP Address",
              "shortDescription": {
                "text": "Private/Internal IP Address"
              },
              "fullDescription": {
                "text": "Exposes live Private/Internal IP Address in plain text."
              },
              "help": {
                "text": "Replace with environment variable and register in .env"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SEC-GITHUB-TOKEN",
              "name": "GitHub Access Token",
              "shortDescription": {
                "text": "GitHub Access Token"
              },
              "fullDescription": {
                "text": "Exposes live GitHub Access Token in plain text."
              },
              "help": {
                "text": "Replace with environment variable and register in .env"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SEC-OPENAI-KEY",
              "name": "OpenAI / Anthropic API Key",
              "shortDescription": {
                "text": "OpenAI / Anthropic API Key"
              },
              "fullDescription": {
                "text": "Exposes live OpenAI / Anthropic API Key in plain text."
              },
              "help": {
                "text": "Replace with environment variable and register in .env"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SEC-AWS-KEY",
              "name": "AWS Access Key",
              "shortDescription": {
                "text": "AWS Access Key"
              },
              "fullDescription": {
                "text": "Exposes live AWS Access Key in plain text."
              },
              "help": {
                "text": "Replace with environment variable and register in .env"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SEC-DB-URI",
              "name": "Database URI with Credentials",
              "shortDescription": {
                "text": "Database URI with Credentials"
              },
              "fullDescription": {
                "text": "Exposes live Database URI with Credentials in plain text."
              },
              "help": {
                "text": "Replace with environment variable and register in .env"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
