          "level": "error",
          "message": {
            "text": "if re.search(r\"(?i)(co-authored-by:\\s*.*(claude|chatgpt|copilot|cursor|antigravity|gemini|aider|devin|cline|bot@|ai@)|generated\\s+by\\s+(claude|cursor|gemini|copilot|chatgpt))\", line):"
          },
          "locations": [
