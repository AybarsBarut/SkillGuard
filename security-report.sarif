          "ruleId": "SEC-SENSITIVE-COMMENT",
          "level": "warning",
          "message": {
            "text": "- \"(?i)(disable|bypass|skip|turn\\\\s+off)\\\\s+(skillguard|guardrails?|safety|security|sandbox|permissions?)\""
